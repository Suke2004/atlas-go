# .gitignore for Atlas

# Binaries
bin/
tmp/
build/

# Environment
.env
.env.local
.env.*.local

# Data directory (contains user data — never commit)
data/**
!data/**/.gitkeep

# Air temp dir
tmp/


# Templ generated files
*_templ.go

# sqlc generated files (optional — some teams commit these)
# internal/db/*.go

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.docker/

# Node (if TailwindCSS CLI is used)
node_modules/
npm-debug.log*

# Test artifacts
testdata/tmp/
