# Atlas Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# -------------------------------------------------------

# ── Server ──────────────────────────────────────────────
ATLAS_PORT=8080

# "development" enables coloured logs, debug endpoints, and skips secret validation.
# "production" enforces all required fields and uses JSON logging.
ATLAS_ENV=development

# ── Database ────────────────────────────────────────────
# Path to the SQLite database file. Created automatically on first run.
ATLAS_DB_PATH=./data/db/atlas.db

# ── Session ─────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
# Must be exactly 32 bytes. Keep this secret.
ATLAS_SESSION_SECRET=

# Session duration in seconds. Default: 86400 (24 hours).
ATLAS_SESSION_MAX_AGE=86400

# ── File Storage ────────────────────────────────────────
# Directory for uploaded files. Files are stored with random UUIDs as names.
# The original filename is stored in the database.
ATLAS_UPLOAD_PATH=./data/uploads

# Maximum upload size in megabytes.
ATLAS_MAX_UPLOAD_MB=50

# ── AI (v2 — not used in v1) ────────────────────────────
# Provider to use: "openai" | "ollama" | "anthropic" | "gemini"
# Defaults to "ollama" (local, no API key required).
ATLAS_AI_PROVIDER=ollama

# API key for cloud providers (OpenAI, Anthropic, Gemini).
# Leave empty when using Ollama.
ATLAS_AI_API_KEY=

# Base URL for the AI provider.
# Ollama default: http://localhost:11434
# OpenAI default: https://api.openai.com/v1
ATLAS_AI_BASE_URL=http://localhost:11434

# Model to use. Examples: llama3.2, mistral, gpt-4o, claude-3-5-sonnet
ATLAS_AI_MODEL=llama3.2

# ── Appearance ──────────────────────────────────────────
# Default theme for new users. Overridden by user settings after first run.
# "light" | "dark" | "system"
ATLAS_THEME_DEFAULT=system

# ── Logging ─────────────────────────────────────────────
# "debug" | "info" | "warn" | "error"
ATLAS_LOG_LEVEL=info