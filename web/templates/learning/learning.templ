package learning

import (
	"fmt"
)

templ Learning(tracks []TrackWithSessions, summary LearningSummary) {
	<div class="space-y-8" x-data="{ showNewTrack: false }">
		<!-- Learning Hero Banner -->
		<div class="p-6 md:p-8 rounded-3xl glass-panel relative overflow-hidden">
			<div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div>
					<div class="flex items-center gap-3 mb-2">
						<span class="px-3 py-1 rounded-full badge-tech text-xs uppercase tracking-widest flex items-center gap-1.5 font-mono-code">
							<i data-lucide="graduation-cap" class="w-3.5 h-3.5 text-cyan-400"></i>
							Tech Mastery
						</span>
						<span class="text-xs text-slate-500 font-mono-code">Code-Verified Proof Enabled</span>
					</div>
					<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Tech Skill Roadmap</h1>
					<p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
						Track developer learning roadmaps, study sessions, streak telemetry, and verifiable mastery proof.
					</p>
				</div>

				<div class="flex items-center gap-3">
					<button @click="showNewTrack = !showNewTrack" type="button" class="px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-xl shadow-indigo-500/20 flex items-center gap-2.5 transition-all">
						<i data-lucide="plus" class="w-4 h-4"></i>
						<span>Add Skill Track</span>
					</button>
				</div>
			</div>

			<!-- Telemetry Bar -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-slate-800/80">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="book-open" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Active Tracks</span>
					</div>
					<div class="text-2xl font-extrabold text-white font-mono-code">{ fmt.Sprintf("%d", summary.TotalTracks) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="clock" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Study Hours</span>
					</div>
					<div class="text-2xl font-extrabold text-cyan-400 font-mono-code">{ fmt.Sprintf("%dh", summary.TotalStudyHours) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="flame" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Active Streaks</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-400 font-mono-code">{ fmt.Sprintf("%d days", summary.ActiveStreaks) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="award" class="w-3.5 h-3.5 text-emerald-400"></i>
						<span>Mastery XP</span>
					</div>
					<div class="text-2xl font-extrabold text-emerald-400 font-mono-code">{ fmt.Sprintf("%d XP", summary.MasteryXP) }</div>
				</div>
			</div>
		</div>

		<!-- New Track Form Drawer Modal -->
		<div x-show="showNewTrack" x-cloak class="glass-panel p-6 rounded-3xl space-y-4">
			<h3 class="text-base font-bold text-white flex items-center gap-2">
				<i data-lucide="plus-circle" class="w-5 h-5 text-indigo-400"></i>
				<span>Add New Tech Skill Track</span>
			</h3>
			<form action="/learning/tracks" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Title</label>
					<input type="text" name="title" required placeholder="Go Concurrency & Microservices" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs"/>
				</div>
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Category</label>
					<select name="category" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs">
						<option value="language">Programming Language</option>
						<option value="framework">Framework / Library</option>
						<option value="dsa">DSA & Algorithms</option>
						<option value="course">Course / Book</option>
					</select>
				</div>
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Description</label>
					<input type="text" name="description" placeholder="Master channels, goroutines, and sqlc" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs"/>
				</div>
				<div class="flex items-end">
					<button type="submit" class="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md">Create Track</button>
				</div>
			</form>
		</div>

		<!-- Skill Tracks Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			if len(tracks) == 0 {
				<div class="col-span-2 text-center py-16 glass-panel rounded-3xl space-y-3">
					<div class="w-12 h-12 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
						<i data-lucide="graduation-cap" class="w-6 h-6"></i>
					</div>
					<h3 class="text-base font-bold text-white">No skill tracks yet</h3>
					<p class="text-xs text-slate-400">Start by adding your first technology learning track.</p>
				</div>
			} else {
				for _, t := range tracks {
					<div class="p-6 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all space-y-4 flex flex-col justify-between shadow-lg">
						<div class="space-y-3">
							<div class="flex items-start justify-between gap-3">
								<div>
									<span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 text-[10px] font-mono-code font-bold uppercase">{ t.Track.Category }</span>
									<h3 class="text-lg font-bold text-white mt-1 leading-snug">{ t.Track.Title }</h3>
								</div>
								<span class="flex items-center gap-1 text-amber-400 font-mono-code text-xs font-bold bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
									<i data-lucide="flame" class="w-3.5 h-3.5 fill-amber-400"></i>
									<span>{ fmt.Sprintf("%dd", t.Track.CurrentStreak) }</span>
								</span>
							</div>

							if t.Track.Description != "" {
								<p class="text-xs text-slate-400 leading-relaxed">{ t.Track.Description }</p>
							}
						</div>

						<div class="pt-4 border-t border-slate-800/80 space-y-3">
							<div class="flex items-center justify-between text-xs text-slate-400 font-mono-code">
								<span>{ fmt.Sprintf("%d mins total study", t.TotalMinutes) }</span>
								<form action={ templ.URL(fmt.Sprintf("/learning/tracks/%d/delete", t.Track.ID)) } method="POST">
									<button type="submit" class="text-slate-500 hover:text-rose-400 p-1">
										<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
									</button>
								</form>
							</div>

							<!-- Log Session Quick Form -->
							<form action="/learning/sessions" method="POST" hx-boost="true" class="flex gap-2">
								<input type="hidden" name="track_id" value={ fmt.Sprintf("%d", t.Track.ID) }/>
								<input type="number" name="duration_minutes" value="30" placeholder="Mins" class="w-20 px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono-code focus:outline-none"/>
								<input type="text" name="summary" placeholder="Session notes..." class="flex-1 px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none"/>
								<button type="submit" class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md">Log</button>
							</form>
						</div>
					</div>
				}
			}
		</div>
	</div>
}
