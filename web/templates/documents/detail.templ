package documents

import (
	"fmt"
)

templ Detail(doc DocumentWithMeta) {
	<div
		class="space-y-8"
		x-data="{
			summarising: false,
			summary: '',
			summaryError: '',
			async triggerSummarise() {
				this.summarising = true;
				this.summary = '';
				this.summaryError = '';
				const docId = window.location.pathname.split('/').filter(Boolean).pop();
				try {
					const resp = await fetch('/documents/' + docId + '/summarise', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
					const data = await resp.json();
					if (data.error) { this.summaryError = data.error; } else { this.summary = data.summary; }
				} catch(e) { this.summaryError = 'Network error — try again.'; }
				finally { this.summarising = false; }
			}
		}"
	>
		<!-- Back nav -->
		<div>
			<a href="/documents" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors group">
				<i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
				Back to Library
			</a>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			<!-- Left: Metadata panel -->
			<div class="space-y-6">
				<!-- File identity card -->
				<div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 space-y-4">
					<div class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700/60 flex items-center justify-center">
						<i data-lucide={ doc.FileIcon } class="w-7 h-7 text-indigo-400"></i>
					</div>
					<div>
						<h1 class="text-lg font-bold text-white leading-tight break-words">{ doc.OriginalName }</h1>
						<p class="text-xs text-slate-500 font-mono-code mt-1">{ doc.MimeType }</p>
					</div>
					<div class="grid grid-cols-2 gap-3">
						<div class="p-3 rounded-xl bg-slate-800/50 border border-slate-700/40">
							<p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Size</p>
							<p class="text-sm font-mono-code text-slate-200">{ doc.HumanSize }</p>
						</div>
						<div class="p-3 rounded-xl bg-slate-800/50 border border-slate-700/40">
							<p class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Type</p>
							<p class={ "text-sm font-mono-code " + previewBadgeClass(doc.PreviewType) }>{ previewLabel(doc.PreviewType) }</p>
						</div>
					</div>
					<!-- Action buttons -->
					<div class="flex flex-col gap-2">
						<a href={ templ.SafeURL(fmt.Sprintf("/documents/%d/download", doc.ID)) }
							class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm text-slate-200 font-medium border border-slate-700/60 transition-all">
							<i data-lucide="download" class="w-4 h-4"></i>
							Download
						</a>
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/documents/%d/delete", doc.ID)) } onsubmit="return confirm('Delete this document permanently? This cannot be undone.')">
							<button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-sm text-rose-400 font-medium border border-rose-500/20 transition-all">
								<i data-lucide="trash-2" class="w-4 h-4"></i>
								Delete
							</button>
						</form>
					</div>
				</div>

				<!-- Edit metadata form -->
				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/documents/%d/meta", doc.ID)) } class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 space-y-4">
					<h2 class="text-sm font-bold text-white">Edit Details</h2>
					<div class="space-y-1">
						<label for="doc-title" class="text-xs text-slate-400">Title</label>
						<input
							id="doc-title"
							type="text"
							name="title"
							value={ doc.Title }
							class="w-full px-3 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-sm text-white focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20"
						/>
					</div>
					<div class="space-y-1">
						<label for="doc-tags" class="text-xs text-slate-400">Tags <span class="text-slate-600">(comma-separated)</span></label>
						<input
							id="doc-tags"
							type="text"
							name="tags"
							value={ joinTags(doc.TagList) }
							placeholder="research, go, design"
							class="w-full px-3 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700/60 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500/60 focus:ring-1 focus:ring-indigo-500/20"
						/>
					</div>
					<button type="submit" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-sm text-white font-bold transition-all">
						<i data-lucide="save" class="w-4 h-4"></i>
						Save Changes
					</button>
				</form>

				<!-- AI Summarise panel -->
				<div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 space-y-4">
					<h2 class="text-sm font-bold text-white flex items-center gap-2">
						<i data-lucide="sparkles" class="w-4 h-4 text-violet-400"></i>
						AI Summary
					</h2>
					if doc.Summary.Valid && doc.Summary.String != "" {
						<div class="text-sm text-slate-300 leading-relaxed prose-sm whitespace-pre-wrap">{ doc.Summary.String }</div>
					}
					<button
						type="button"
						@click="triggerSummarise()"
						:disabled="summarising"
						class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-violet-600/20 hover:bg-violet-600/30 text-sm text-violet-300 font-medium border border-violet-500/30 transition-all disabled:opacity-50 disabled:cursor-wait"
					>
						<i data-lucide="sparkles" class="w-4 h-4" x-show="!summarising"></i>
						<i data-lucide="loader-2" class="w-4 h-4 animate-spin" x-show="summarising" x-cloak></i>
						<span x-text="summarising ? 'Generating summary...' : (summary ? 'Regenerate Summary' : 'Generate AI Summary')"></span>
					</button>
					<div x-show="summary" x-transition class="text-sm text-slate-300 leading-relaxed whitespace-pre-wrap border-t border-slate-700/60 pt-3 mt-1">
						<span x-text="summary"></span>
					</div>
					<div x-show="summaryError" x-transition class="flex items-start gap-2 text-xs text-rose-400 border-t border-rose-500/20 pt-3 mt-1">
						<i data-lucide="alert-circle" class="w-3.5 h-3.5 flex-shrink-0 mt-0.5"></i>
						<span x-text="summaryError"></span>
					</div>
				</div>
			</div>

			<!-- Right: Preview panel -->
			<div class="lg:col-span-2">
				<div class="rounded-2xl bg-slate-900/60 border border-slate-800/80 overflow-hidden h-full min-h-[600px]">
					<div class="px-5 py-4 border-b border-slate-800/60 flex items-center gap-3">
						<i data-lucide="eye" class="w-4 h-4 text-slate-400"></i>
						<span class="text-sm font-medium text-slate-300">Preview</span>
					</div>
					<div class="p-0 h-full">
						if doc.PreviewType == "pdf" {
							<iframe
								src={ templ.SafeURL(fmt.Sprintf("/documents/%d/raw", doc.ID)) }
								class="w-full h-[720px] border-none"
								title={ doc.OriginalName }
							></iframe>
						} else if doc.PreviewType == "image" {
							<div class="flex items-center justify-center p-8 min-h-[400px]">
								<img
									src={ templ.SafeURL(fmt.Sprintf("/documents/%d/raw", doc.ID)) }
									alt={ doc.OriginalName }
									class="max-w-full max-h-[600px] object-contain rounded-xl shadow-2xl"
								/>
							</div>
						} else if doc.PreviewType == "text" {
							if doc.ContentText.Valid && doc.ContentText.String != "" {
								<pre class="p-6 text-sm text-slate-300 font-mono-code overflow-auto h-[720px] whitespace-pre-wrap leading-relaxed">{ doc.ContentText.String }</pre>
							} else {
								<div class="flex flex-col items-center justify-center h-[400px] text-slate-500 gap-3">
									<i data-lucide="file-text" class="w-12 h-12"></i>
									<p class="text-sm">Content not extracted yet</p>
								</div>
							}
						} else {
							<div class="flex flex-col items-center justify-center h-[400px] text-slate-500 gap-4">
								<i data-lucide={ doc.FileIcon } class="w-14 h-14 text-slate-600"></i>
								<div class="text-center">
									<p class="text-sm font-medium text-slate-400">No preview available</p>
									<p class="text-xs text-slate-600 mt-1">This file type cannot be previewed in the browser.</p>
								</div>
								<a href={ templ.SafeURL(fmt.Sprintf("/documents/%d/download", doc.ID)) }
									class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm text-white font-medium border border-slate-700/60 transition-all flex items-center gap-2">
									<i data-lucide="download" class="w-4 h-4"></i>
									Download to View
								</a>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
