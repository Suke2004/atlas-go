package projects

import (
	"fmt"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ GitHubCard(project db.Project) {
	<div id="github-insights-card" class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 backdrop-blur-xl shadow-xl space-y-4">
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 text-white flex items-center justify-center font-bold">
					<i data-lucide="github" class="w-5 h-5 text-slate-200"></i>
				</div>
				<div>
					<h3 class="text-base font-bold text-white">GitHub Integration</h3>
					<p class="text-xs text-slate-400">Live repository metrics & insights</p>
				</div>
			</div>
			if project.GithubUrl != "" {
				<div class="flex items-center gap-2">
					<button hx-post={ fmt.Sprintf("/projects/%d/sync-github", project.ID) } hx-target="#github-insights-card" hx-swap="outerHTML" type="button" class="px-3 py-1.5 rounded-lg bg-indigo-600/20 text-indigo-400 hover:bg-indigo-600/30 border border-indigo-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all">
						<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
						<span>Sync Stats</span>
					</button>
					<a href={ templ.SafeURL(project.GithubUrl) } target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition-all">
						<i data-lucide="external-link" class="w-3.5 h-3.5"></i>
						<span>View Repo</span>
					</a>
				</div>
			}
		</div>

		if project.GithubUrl != "" {
			<div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-2">
				<div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center">
					<div class="text-xs font-medium text-slate-400 mb-1 flex items-center justify-center gap-1">
						<i data-lucide="star" class="w-3.5 h-3.5 text-amber-400"></i> Stars
					</div>
					<div class="text-lg font-bold text-white">{ fmt.Sprintf("%d", project.GithubStars) }</div>
				</div>
				<div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center">
					<div class="text-xs font-medium text-slate-400 mb-1 flex items-center justify-center gap-1">
						<i data-lucide="git-fork" class="w-3.5 h-3.5 text-indigo-400"></i> Forks
					</div>
					<div class="text-lg font-bold text-white">{ fmt.Sprintf("%d", project.GithubForks) }</div>
				</div>
				<div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center">
					<div class="text-xs font-medium text-slate-400 mb-1 flex items-center justify-center gap-1">
						<i data-lucide="circle-dot" class="w-3.5 h-3.5 text-rose-400"></i> Open Issues
					</div>
					<div class="text-lg font-bold text-white">{ fmt.Sprintf("%d", project.GithubOpenIssues) }</div>
				</div>
				<div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-center">
					<div class="text-xs font-medium text-slate-400 mb-1 flex items-center justify-center gap-1">
						<i data-lucide="code" class="w-3.5 h-3.5 text-emerald-400"></i> Primary Language
					</div>
					<div class="text-sm font-bold text-emerald-400 truncate">
						if project.GithubLanguage != "" {
							{ project.GithubLanguage }
						} else {
							N/A
						}
					</div>
				</div>
			</div>

			if project.GithubOpenIssues > 0 {
				<div class="pt-2 flex items-center justify-between border-t border-slate-800/60 text-xs">
					<span class="text-slate-400">Convert open GitHub issues into milestones:</span>
					<form action={ fmt.Sprintf("/projects/%d/import-issues", project.ID) } method="POST">
						<button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 hover:bg-emerald-600/30 border border-emerald-500/30 font-semibold transition-all">
							Import Issues as Milestones
						</button>
					</form>
				</div>
			}
		} else {
			<div class="text-center py-4 text-slate-500 text-xs">
				No GitHub repository attached. Edit project to add a GitHub URL.
			</div>
		}
	</div>
}
