package projects

import (
	"fmt"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ GitHubCard(project db.Project) {
	if project.GithubUrl != "" {
		<div id="github-card" class="p-8 rounded-3xl glass-panel relative overflow-hidden space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800/80 pb-4">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded-2xl bg-slate-800/80 border border-slate-700 text-white flex items-center justify-center font-bold">
						<i data-lucide="github" class="w-5 h-5"></i>
					</div>
					<div>
						<h3 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
							<span>Repository Insights</span>
							<a href={ templ.URL(project.GithubUrl) } target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300 transition-colors">
								<i data-lucide="external-link" class="w-4 h-4"></i>
							</a>
						</h3>
						<p class="text-xs text-slate-400 font-mono-code">{ project.GithubUrl }</p>
					</div>
				</div>

				<!-- Refresh Stats & Import Issues Actions -->
				<div class="flex items-center gap-2">
					<form action={ templ.URL(fmt.Sprintf("/projects/%d/import-issues", project.ID)) } method="POST">
						<button type="submit" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 transition-all">
							<i data-lucide="download-cloud" class="w-3.5 h-3.5 text-cyan-400"></i>
							<span>Import Issues</span>
						</button>
					</form>

					<form hx-post={ fmt.Sprintf("/projects/%d/sync-github", project.ID) } hx-target="#github-card" hx-swap="outerHTML">
						<button type="submit" class="px-3.5 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/20 text-xs font-semibold flex items-center gap-2 transition-all">
							<i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
							<span>Sync Stats</span>
						</button>
					</form>
				</div>
			</div>

			<!-- Metrics Grid -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono-code">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800">
					<div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5">
						<i data-lucide="star" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Stars</span>
					</div>
					<div class="text-2xl font-bold text-amber-400">{ fmt.Sprintf("%d", project.GithubStars) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800">
					<div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5">
						<i data-lucide="git-fork" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Forks</span>
					</div>
					<div class="text-2xl font-bold text-cyan-400">{ fmt.Sprintf("%d", project.GithubForks) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800">
					<div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5">
						<i data-lucide="bug" class="w-3.5 h-3.5 text-rose-400"></i>
						<span>Open Issues</span>
					</div>
					<div class="text-2xl font-bold text-rose-400">{ fmt.Sprintf("%d", project.GithubOpenIssues) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800">
					<div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5">
						<i data-lucide="code" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Primary Stack</span>
					</div>
					<div class="text-lg font-bold text-indigo-300 truncate">
						if project.GithubLanguage != "" {
							{ project.GithubLanguage }
						} else {
							<span class="text-slate-500 text-xs">—</span>
						}
					</div>
				</div>
			</div>
		</div>
	}
}
