package projects

import (
	"fmt"
	"strings"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ Detail(project db.Project, milestones []db.Milestone, errorMsg string) {
	<div class="space-y-8" x-data="{ showEditModal: false, showMilestoneModal: false }">
		<!-- Breadcrumbs Navigation -->
		<div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
			<a href="/projects" hx-boost="true" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5">
				<i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
				<span>Projects</span>
			</a>
			<i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-600"></i>
			<span class="text-white font-bold">{ project.Name }</span>
		</div>

		<!-- Project Header Hero Card -->
		<div class="p-8 rounded-3xl glass-panel relative overflow-hidden space-y-6">
			<!-- Subtle Accent Bar -->
			<div class="h-2.5 -mx-8 -mt-8 mb-6" style={ fmt.Sprintf("background-color: %s;", project.Color) }></div>

			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
				<div class="space-y-2">
					<div class="flex items-center gap-3">
						<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">{ project.Name }</h1>
						<span class={ statusBadgeClass(project.Status) }>{ project.Status }</span>
					</div>

					if project.Description != "" {
						<p class="text-slate-300 text-sm max-w-2xl leading-relaxed">{ project.Description }</p>
					}
				</div>

				<!-- Edit / Delete Actions -->
				<div class="flex items-center gap-3 flex-shrink-0">
					<button @click="showEditModal = true" type="button" class="px-4 py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-700 transition-all">
						<i data-lucide="edit-3" class="w-4 h-4 text-cyan-400"></i>
						<span>Edit Project</span>
					</button>

					<form action={ templ.URL(fmt.Sprintf("/projects/%d/delete", project.ID)) } method="POST" onsubmit="return confirm('Are you sure you want to delete this project?');">
						<button type="submit" class="px-4 py-2.5 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30 text-xs font-semibold flex items-center gap-2 transition-all">
							<i data-lucide="trash-2" class="w-4 h-4"></i>
							<span>Delete</span>
						</button>
					</form>
				</div>
			</div>

			<!-- Tech Stack Architecture Pills -->
			if project.TechStack != "" {
				<div class="pt-4 border-t border-slate-800/80">
					<div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
						<i data-lucide="layers" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Tech Stack Architecture</span>
					</div>
					<div class="flex flex-wrap gap-2">
						for _, tag := range strings.Split(project.TechStack, ",") {
							if strings.TrimSpace(tag) != "" {
								<span class="px-3.5 py-1 rounded-xl badge-tech text-xs font-mono-code flex items-center gap-1.5">
									<span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
									#{ strings.TrimSpace(tag) }
								</span>
							}
						}
					</div>
				</div>
			}

			<!-- Milestone Progress Indicator -->
			<div class="pt-4 border-t border-slate-800/80 space-y-2">
				<div class="flex justify-between items-center text-sm font-semibold">
					<span class="text-slate-400">Milestone Deliverable Progress</span>
					<span class="text-cyan-400 font-bold font-mono-code text-base">{ fmt.Sprintf("%d%%", project.ProgressPercentage) }</span>
				</div>
				<div class="w-full h-3 rounded-full bg-slate-950 overflow-hidden">
					<div class="h-full bg-gradient-to-r from-cyan-500 via-indigo-500 to-amber-500 transition-all duration-300" style={ fmt.Sprintf("width: %d%%;", project.ProgressPercentage) }></div>
				</div>
			</div>
		</div>

		<!-- GitHub Insights Card Fragment -->
		@GitHubCard(project)

		<!-- Milestones Deliverables Checklist Section -->
		<div class="p-8 rounded-3xl glass-panel space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
						<i data-lucide="check-square" class="w-5 h-5 text-cyan-400"></i>
						<span>Project Milestones & Key Deliverables</span>
					</h2>
					<p class="text-slate-400 text-xs mt-1">Check off completed milestones to update project percentage.</p>
				</div>

				<button @click="showMilestoneModal = true" type="button" class="px-5 py-2.5 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/40 text-xs font-bold flex items-center gap-2 transition-all">
					<i data-lucide="plus" class="w-4 h-4"></i>
					<span>Add Milestone</span>
				</button>
			</div>

			if len(milestones) == 0 {
				<div class="text-center py-10 text-slate-500 text-xs font-mono-code border border-dashed border-slate-800 rounded-2xl">
					No milestones recorded yet. Click "Add Milestone" to set your targets.
				</div>
			} else {
				<div class="space-y-3">
					for _, m := range milestones {
						<div class="flex items-center justify-between p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all">
							<form action={ templ.URL(fmt.Sprintf("/projects/%d/milestones/%d/toggle", project.ID, m.ID)) } method="POST" class="flex items-center gap-3.5">
								<input type="checkbox" name="completed" value="true" checked?={ m.IsCompleted } onchange="this.form.submit()" class="w-5 h-5 rounded bg-slate-950 border-slate-700 text-cyan-500 focus:ring-cyan-500 cursor-pointer"/>
								<span class={ milestoneTitleClass(m.IsCompleted) }>{ m.Title }</span>
							</form>

							<div class="flex items-center gap-3">
								if m.IsCompleted {
									<span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-mono-code">Completed</span>
								}
								<form action={ templ.URL(fmt.Sprintf("/projects/%d/milestones/%d/delete", project.ID, m.ID)) } method="POST">
									<button type="submit" title="Delete Milestone" class="text-slate-500 hover:text-rose-400 transition-colors p-1">
										<i data-lucide="trash" class="w-4 h-4"></i>
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		</div>

		<!-- Edit Project Modal -->
		<div x-show="showEditModal" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md" style="display: none;">
			<div @click.outside="showEditModal = false" class="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-6 shadow-2xl">
				<div class="flex items-center justify-between border-b border-slate-800 pb-4">
					<h3 class="text-xl font-bold text-white">Edit Project Settings</h3>
					<button @click="showEditModal = false" type="button" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
				</div>
				<form action={ templ.URL(fmt.Sprintf("/projects/%d/edit", project.ID)) } method="POST" class="space-y-4">
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Project Name</label>
						<input type="text" name="name" value={ project.Name } required class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Description</label>
						<textarea name="description" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">{ project.Description }</textarea>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Status</label>
							<select name="status" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
								<option value="active" selected?={ project.Status == "active" }>Active</option>
								<option value="completed" selected?={ project.Status == "completed" }>Completed</option>
								<option value="archived" selected?={ project.Status == "archived" }>Archived</option>
								<option value="on_hold" selected?={ project.Status == "on_hold" }>On Hold</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Accent Color</label>
							<input type="color" name="color" value={ project.Color } class="w-full h-10 rounded-xl bg-slate-800/60 border border-slate-700 cursor-pointer"/>
						</div>
					</div>
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">GitHub Repository URL</label>
						<input type="text" name="github_url" value={ project.GithubUrl } placeholder="https://github.com/owner/repo" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tech Stack Tags</label>
						<input type="text" name="tech_stack" value={ project.TechStack } placeholder="Go, SQLite, HTMX, TailwindCSS" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>
					<div class="pt-4 flex justify-end gap-3 border-t border-slate-800">
						<button @click="showEditModal = false" type="button" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm">Cancel</button>
						<button type="submit" class="px-5 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm">Save Changes</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Add Milestone Modal -->
		<div x-show="showMilestoneModal" x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md" style="display: none;">
			<div @click.outside="showMilestoneModal = false" class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-6 shadow-2xl">
				<div class="flex items-center justify-between border-b border-slate-800 pb-4">
					<h3 class="text-xl font-bold text-white">Add Milestone Target</h3>
					<button @click="showMilestoneModal = false" type="button" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
				</div>
				<form action={ templ.URL(fmt.Sprintf("/projects/%d/milestones", project.ID)) } method="POST" class="space-y-4">
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Milestone Title *</label>
						<input type="text" name="title" required placeholder="e.g. Implement Auth System" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>
					<div class="pt-4 flex justify-end gap-3 border-t border-slate-800">
						<button @click="showMilestoneModal = false" type="button" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm">Cancel</button>
						<button type="submit" class="px-5 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm">Add Milestone</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
