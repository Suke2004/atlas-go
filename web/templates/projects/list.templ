package projects

import (
	"fmt"
	"strings"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ List(projectList []db.Project, summary ProjectsSummary, currentFilter string, viewMode string, tagFilter string, searchQuery string, errorMsg string) {
	<div class="space-y-8" x-data="{ showDrawer: false, view: 'grid' }">
		<!-- Executive Hero Summary Banner -->
		<div class="p-6 md:p-8 rounded-3xl glass-panel relative overflow-hidden">
			<!-- Subtle ambient glowing accent blob -->
			<div class="absolute -top-16 -right-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-16 -left-16 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

			<div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div>
					<div class="flex items-center gap-3 mb-2">
						<span class="px-3 py-1 rounded-full badge-tech text-xs uppercase tracking-widest flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
							Atlas Workspace Engine
						</span>
					</div>
					<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Projects & Quadrants</h1>
					<p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
						Track your engineering initiatives, GitHub repository metrics, tech stack architecture, and milestone deliverables in one unified horizon.
					</p>
				</div>

				<!-- Quick Actions & New Project Trigger -->
				<div class="flex items-center gap-3">
					<button @click="showDrawer = true" type="button" class="px-6 py-3 rounded-2xl bg-gradient-to-r from-cyan-500 via-indigo-600 to-amber-500 hover:from-cyan-400 hover:to-amber-400 text-white font-bold text-sm shadow-xl shadow-cyan-500/20 flex items-center gap-2.5 transition-all duration-200 hover:-translate-y-0.5">
						<i data-lucide="plus" class="w-4 h-4"></i>
						<span>Create Project</span>
					</button>
				</div>
			</div>

			<!-- Executive Metrics Row -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-slate-800/80">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="folder" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Active Initiatives</span>
					</div>
					<div class="text-2xl font-extrabold text-white font-mono-code">
						{ fmt.Sprintf("%d", summary.ActiveProjects) } <span class="text-xs font-normal text-slate-500">/ { fmt.Sprintf("%d", summary.TotalProjects) } total</span>
					</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i>
						<span>Milestone Ratio</span>
					</div>
					<div class="text-2xl font-extrabold text-emerald-400 font-mono-code">
						{ fmt.Sprintf("%d%%", summary.MilestoneCompletionRate) } <span class="text-xs font-normal text-slate-500">({ fmt.Sprintf("%d/%d", summary.CompletedMilestones, summary.TotalMilestones) })</span>
					</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="star" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>GitHub Stars</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-400 font-mono-code">
						{ fmt.Sprintf("%d", summary.TotalStars) } <span class="text-xs font-normal text-slate-500">stars</span>
					</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="layers" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Tech Diversity</span>
					</div>
					<div class="text-lg font-bold text-indigo-300 truncate font-mono-code">
						if len(summary.TopTechStack) > 0 {
							{ strings.Join(summary.TopTechStack[:min(len(summary.TopTechStack), 3)], ", ") }
						} else {
							<span class="text-slate-500 text-xs font-normal">None configured</span>
						}
					</div>
				</div>
			</div>
		</div>

		<!-- Control Toolbar: Status Tabs, View Switcher & Live Search -->
		<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 glass-panel p-4 rounded-2xl">
			<!-- Status Filter Tabs -->
			<div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0">
				<a href="/projects?status=all" hx-boost="true" class={ filterTabClass(currentFilter == "all" || currentFilter == "") }>
					<span>All Initiatives</span>
					<span class="px-2 py-0.5 rounded-full bg-slate-800 text-[11px] text-slate-300 font-mono-code">{ fmt.Sprintf("%d", summary.TotalProjects) }</span>
				</a>
				<a href="/projects?status=active" hx-boost="true" class={ filterTabClass(currentFilter == "active") }>
					<span>Active</span>
					<span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[11px] font-mono-code">{ fmt.Sprintf("%d", summary.ActiveProjects) }</span>
				</a>
				<a href="/projects?status=completed" hx-boost="true" class={ filterTabClass(currentFilter == "completed") }>
					<span>Completed</span>
					<span class="px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 text-[11px] font-mono-code">{ fmt.Sprintf("%d", summary.CompletedProjects) }</span>
				</a>
				<a href="/projects?status=archived" hx-boost="true" class={ filterTabClass(currentFilter == "archived") }>
					<span>Archived</span>
				</a>
			</div>

			<!-- Search & View Mode Buttons -->
			<div class="flex items-center gap-3">
				<!-- Search Form Input -->
				<form action="/projects" method="GET" hx-boost="true" class="relative min-w-[220px]">
					<i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
					<input type="text" name="search" value={ searchQuery } placeholder="Search projects..." class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
				</form>

				<!-- View Mode Buttons -->
				<div class="flex items-center p-1 rounded-xl bg-slate-900/80 border border-slate-800">
					<a href={ templ.URL(fmt.Sprintf("/projects?status=%s&view=grid", currentFilter)) } hx-boost="true" title="Grid View" class={ viewButtonClass(viewMode == "grid" || viewMode == "") }>
						<i data-lucide="layout-grid" class="w-4 h-4"></i>
					</a>
					<a href={ templ.URL(fmt.Sprintf("/projects?status=%s&view=table", currentFilter)) } hx-boost="true" title="Table View" class={ viewButtonClass(viewMode == "table") }>
						<i data-lucide="list" class="w-4 h-4"></i>
					</a>
					<a href={ templ.URL(fmt.Sprintf("/projects?status=%s&view=roadmap", currentFilter)) } hx-boost="true" title="Roadmap Timeline" class={ viewButtonClass(viewMode == "roadmap") }>
						<i data-lucide="kanban" class="w-4 h-4"></i>
					</a>
				</div>
			</div>
		</div>

		<!-- Interactive Tech Stack Tag Filter Strip -->
		if len(summary.TopTechStack) > 0 {
			<div class="flex items-center gap-2 overflow-x-auto py-1">
				<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1 mr-2">
					<i data-lucide="tag" class="w-3.5 h-3.5 text-cyan-400"></i>
					<span>Filter Tech:</span>
				</span>
				if tagFilter != "" {
					<a href={ templ.URL(fmt.Sprintf("/projects?status=%s", currentFilter)) } hx-boost="true" class="px-3 py-1 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-mono-code flex items-center gap-1.5 hover:bg-rose-500/20 transition-colors">
						<span>Clear Filter ({ tagFilter })</span>
						<i data-lucide="x" class="w-3 h-3"></i>
					</a>
				}
				for _, tag := range summary.TopTechStack {
					<a href={ templ.URL(fmt.Sprintf("/projects?status=%s&tag=%s", currentFilter, tag)) } hx-boost="true" class={ techTagPillClass(strings.EqualFold(tagFilter, tag)) }>
						<span>#{ tag }</span>
					</a>
				}
			</div>
		}

		<!-- Projects View Container Target -->
		<div id="projects-content">
			@ProjectContent(projectList, currentFilter, viewMode, tagFilter, searchQuery)
		</div>

		<!-- Slide-Over Drawer Form for Creating Projects -->
		<div x-show="showDrawer" x-transition.opacity class="fixed inset-0 z-50 flex justify-end bg-slate-950/80 backdrop-blur-md" style="display: none;">
			<div @click.outside="showDrawer = false" class="w-full max-w-xl bg-slate-900 border-l border-slate-800 h-full p-8 overflow-y-auto space-y-6 shadow-2xl">
				<div class="flex items-center justify-between border-b border-slate-800 pb-4">
					<div>
						<h3 class="text-2xl font-bold text-white tracking-tight">Create New Project</h3>
						<p class="text-xs text-slate-400 mt-0.5">Initialize a new project quadrant in your Atlas workspace.</p>
					</div>
					<button @click="showDrawer = false" type="button" class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-slate-800 transition-colors">
						<i data-lucide="x" class="w-5 h-5"></i>
					</button>
				</div>

				<form action="/projects" method="POST" class="space-y-5">
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Project Name *</label>
						<input type="text" name="name" required placeholder="e.g. Atlas Personal OS" class="w-full px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 text-sm"/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Description</label>
						<textarea name="description" rows="3" placeholder="Brief project goals & architecture..." class="w-full px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 text-sm leading-relaxed"></textarea>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Status</label>
							<select name="status" class="w-full px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500">
								<option value="active" selected>Active</option>
								<option value="completed">Completed</option>
								<option value="archived">Archived</option>
								<option value="on_hold">On Hold</option>
							</select>
						</div>

						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Accent Color</label>
							<input type="color" name="color" value="#3a86ff" class="w-full h-11 rounded-xl bg-slate-800/60 border border-slate-700 cursor-pointer"/>
						</div>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">GitHub Repository URL</label>
						<input type="text" name="github_url" placeholder="https://github.com/owner/repo" class="w-full px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tech Stack Tags (Comma-separated)</label>
						<input type="text" name="tech_stack" placeholder="Go, SQLite, HTMX, TailwindCSS" class="w-full px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500"/>
					</div>

					<div class="pt-6 flex justify-end gap-3 border-t border-slate-800">
						<button @click="showDrawer = false" type="button" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-colors">Cancel</button>
						<button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-cyan-500/20 transition-all">Initialize Project</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

templ ProjectContent(projectList []db.Project, currentFilter string, viewMode string, tagFilter string, searchQuery string) {
	if len(projectList) == 0 {
		<div class="text-center py-20 px-4 glass-panel rounded-3xl space-y-4">
			<div class="w-14 h-14 rounded-2xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mx-auto text-2xl font-bold border border-cyan-500/20">
				<i data-lucide="folder-kanban" class="w-7 h-7"></i>
			</div>
			<h3 class="text-xl font-bold text-white">No matching projects</h3>
			<p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
				No initiatives found matching your current filter criteria. Create a new project or clear your search parameters.
			</p>
		</div>
	} else if viewMode == "table" {
		@ProjectTable(projectList)
	} else if viewMode == "roadmap" {
		@ProjectRoadmap(projectList)
	} else {
		@ProjectGrid(projectList)
	}
}

templ ProjectGrid(projectList []db.Project) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		for _, p := range projectList {
			<a href={ templ.URL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="group block rounded-3xl glass-panel overflow-hidden transition-all duration-300 hover:-translate-y-1">
				<!-- Accent Header Bar -->
				<div class="h-2 w-full" style={ fmt.Sprintf("background-color: %s;", p.Color) }></div>

				<div class="p-6 space-y-4">
					<!-- Title & Status Badge -->
					<div class="flex items-start justify-between gap-4">
						<h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors truncate">{ p.Name }</h3>
						<span class={ statusBadgeClass(p.Status) }>{ p.Status }</span>
					</div>

					<!-- Description -->
					if p.Description != "" {
						<p class="text-slate-400 text-xs line-clamp-2 leading-relaxed">{ p.Description }</p>
					}

					<!-- Tech Stack Badges -->
					if p.TechStack != "" {
						<div class="flex flex-wrap gap-1.5">
							for _, tag := range strings.Split(p.TechStack, ",") {
								if strings.TrimSpace(tag) != "" {
									<span class="px-2.5 py-0.5 rounded-lg badge-tech text-[10px] font-mono-code">#{ strings.TrimSpace(tag) }</span>
								}
							}
						</div>
					}

					<!-- GitHub Repo Metrics Row -->
					if p.GithubUrl != "" {
						<div class="flex items-center gap-4 text-xs text-slate-400 pt-3 border-t border-slate-800/80 font-mono-code">
							<div class="flex items-center gap-1.5">
								<i data-lucide="star" class="w-3.5 h-3.5 text-amber-400"></i>
								<span>{ fmt.Sprintf("%d", p.GithubStars) }</span>
							</div>
							<div class="flex items-center gap-1.5">
								<i data-lucide="git-fork" class="w-3.5 h-3.5 text-cyan-400"></i>
								<span>{ fmt.Sprintf("%d", p.GithubForks) }</span>
							</div>
							if p.GithubLanguage != "" {
								<div class="ml-auto text-[11px] text-slate-300 font-semibold">{ p.GithubLanguage }</div>
							}
						</div>
					}

					<!-- Progress Bar -->
					<div class="space-y-1.5 pt-2">
						<div class="flex justify-between text-xs font-semibold">
							<span class="text-slate-400">Milestone Progress</span>
							<span class="text-cyan-400 font-mono-code">{ fmt.Sprintf("%d%%", p.ProgressPercentage) }</span>
						</div>
						<div class="w-full h-2 rounded-full bg-slate-950 overflow-hidden">
							<div class="h-full bg-gradient-to-r from-cyan-500 to-indigo-500 transition-all duration-300" style={ fmt.Sprintf("width: %d%%;", p.ProgressPercentage) }></div>
						</div>
					</div>
				</div>
			</a>
		}
	</div>
}

templ ProjectTable(projectList []db.Project) {
	<div class="glass-panel rounded-3xl overflow-hidden">
		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="border-b border-slate-800/80 text-xs font-bold text-slate-400 uppercase tracking-wider">
						<th class="py-4 px-6">Project Name</th>
						<th class="py-4 px-6">Status</th>
						<th class="py-4 px-6">Tech Stack</th>
						<th class="py-4 px-6">GitHub Stars</th>
						<th class="py-4 px-6">Progress</th>
						<th class="py-4 px-6 text-right">Action</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-800/60 text-sm">
					for _, p := range projectList {
						<tr class="hover:bg-slate-800/40 transition-colors">
							<td class="py-4 px-6 font-bold text-white">
								<a href={ templ.URL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="flex items-center gap-3 hover:text-cyan-400 transition-colors">
									<span class="w-3 h-3 rounded-full flex-shrink-0" style={ fmt.Sprintf("background-color: %s;", p.Color) }></span>
									<span>{ p.Name }</span>
								</a>
							</td>
							<td class="py-4 px-6">
								<span class={ statusBadgeClass(p.Status) }>{ p.Status }</span>
							</td>
							<td class="py-4 px-6">
								if p.TechStack != "" {
									<div class="flex flex-wrap gap-1 font-mono-code text-[11px] text-cyan-300">
										{ p.TechStack }
									</div>
								} else {
									<span class="text-slate-500 text-xs">—</span>
								}
							</td>
							<td class="py-4 px-6 font-mono-code text-xs text-amber-400">
								if p.GithubUrl != "" {
									<div class="flex items-center gap-1">
										<i data-lucide="star" class="w-3.5 h-3.5"></i>
										<span>{ fmt.Sprintf("%d", p.GithubStars) }</span>
									</div>
								} else {
									<span class="text-slate-500">—</span>
								}
							</td>
							<td class="py-4 px-6">
								<div class="flex items-center gap-3">
									<div class="w-24 h-2 rounded-full bg-slate-950 overflow-hidden">
										<div class="h-full bg-cyan-500" style={ fmt.Sprintf("width: %d%%;", p.ProgressPercentage) }></div>
									</div>
									<span class="text-xs font-mono-code text-cyan-400">{ fmt.Sprintf("%d%%", p.ProgressPercentage) }</span>
								</div>
							</td>
							<td class="py-4 px-6 text-right">
								<a href={ templ.URL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition-colors">
									View Details
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ ProjectRoadmap(projectList []db.Project) {
	<div class="glass-panel rounded-3xl p-8 space-y-6">
		<h3 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
			<i data-lucide="kanban" class="w-5 h-5 text-cyan-400"></i>
			<span>Initiatives Timeline Roadmap</span>
		</h3>
		<div class="space-y-6">
			for _, p := range projectList {
				<div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-3">
							<span class="w-3 h-3 rounded-full" style={ fmt.Sprintf("background-color: %s;", p.Color) }></span>
							<a href={ templ.URL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="text-lg font-bold text-white hover:text-cyan-400 transition-colors">{ p.Name }</a>
						</div>
						<span class="text-xs font-mono-code text-cyan-400 font-bold">{ fmt.Sprintf("%d%% Complete", p.ProgressPercentage) }</span>
					</div>
					<div class="w-full h-3 rounded-full bg-slate-950 overflow-hidden">
						<div class="h-full bg-gradient-to-r from-cyan-500 via-indigo-500 to-amber-500" style={ fmt.Sprintf("width: %d%%;", p.ProgressPercentage) }></div>
					</div>
				</div>
			}
		</div>
	</div>
}
