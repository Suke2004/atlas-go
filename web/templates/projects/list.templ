package projects

import (
	"fmt"
	"strings"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ List(projects []db.Project, currentFilter string, errorMsg string) {
	<div class="space-y-8" x-data="{ showModal: false }">
		<!-- Header & Actions -->
		<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold text-white tracking-tight">Projects</h1>
				<p class="text-slate-400 text-sm mt-1">Manage your active initiatives, GitHub repositories, and tech stacks.</p>
			</div>
			<button @click="showModal = true" type="button" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/30 flex items-center gap-2 transition-all">
				<i data-lucide="plus" class="w-4 h-4"></i>
				<span>New Project</span>
			</button>
		</div>

		<!-- Status Filter Tabs -->
		<div class="flex items-center gap-2 border-b border-slate-800 pb-4 overflow-x-auto">
			<a href="/projects?status=all" hx-boost="true" class={ filterTabClass(currentFilter == "all" || currentFilter == "") }>
				<span>All Projects</span>
				<span class="px-2 py-0.5 rounded-full bg-slate-800 text-[11px] text-slate-400">{ fmt.Sprintf("%d", len(projects)) }</span>
			</a>
			<a href="/projects?status=active" hx-boost="true" class={ filterTabClass(currentFilter == "active") }>
				<span>Active</span>
			</a>
			<a href="/projects?status=completed" hx-boost="true" class={ filterTabClass(currentFilter == "completed") }>
				<span>Completed</span>
			</a>
			<a href="/projects?status=archived" hx-boost="true" class={ filterTabClass(currentFilter == "archived") }>
				<span>Archived</span>
			</a>
		</div>

		<!-- Project Grid Container -->
		<div id="projects-grid">
			@ProjectGrid(projects, currentFilter)
		</div>

		<!-- New Project Modal -->
		<div x-show="showModal" @click.outside="showModal = false" x-transition class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm" style="display: none;">
			<div class="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-6 space-y-6">
				<div class="flex items-center justify-between border-b border-slate-800 pb-4">
					<h3 class="text-xl font-bold text-white">Create New Project</h3>
					<button @click="showModal = false" type="button" class="text-slate-400 hover:text-white">
						<i data-lucide="x" class="w-5 h-5"></i>
					</button>
				</div>

				<form action="/projects" method="POST" class="space-y-4">
					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Project Name</label>
						<input type="text" name="name" required placeholder="e.g. Atlas Personal OS" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Description</label>
						<textarea name="description" rows="2" placeholder="Brief project summary..." class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Status</label>
							<select name="status" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
								<option value="active" selected>Active</option>
								<option value="completed">Completed</option>
								<option value="archived">Archived</option>
								<option value="on_hold">On Hold</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Accent Color</label>
							<input type="color" name="color" value="#6366f1" class="w-full h-10 rounded-xl bg-slate-800/60 border border-slate-700 cursor-pointer"/>
						</div>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">GitHub Repository URL (Optional)</label>
						<input type="text" name="github_url" placeholder="https://github.com/owner/repo" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Tech Stack Tags (Comma-separated)</label>
						<input type="text" name="tech_stack" placeholder="Go, SQLite, HTMX, TailwindCSS" class="w-full px-4 py-2.5 rounded-xl bg-slate-800/60 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
					</div>

					<div class="pt-4 flex justify-end gap-3 border-t border-slate-800">
						<button @click="showModal = false" type="button" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm">Cancel</button>
						<button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm">Create Project</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

templ ProjectGrid(projects []db.Project, currentFilter string) {
	if len(projects) == 0 {
		<div class="text-center py-16 px-4 bg-slate-900/50 border border-slate-800/80 rounded-2xl space-y-3">
			<div class="w-12 h-12 rounded-2xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center mx-auto text-xl font-bold">
				<i data-lucide="folder-kanban" class="w-6 h-6"></i>
			</div>
			<h3 class="text-lg font-bold text-white">No projects found</h3>
			<p class="text-slate-400 text-sm max-w-sm mx-auto">Get started by creating your first project or connecting a GitHub repository.</p>
		</div>
	} else {
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			for _, p := range projects {
				<a href={ templ.SafeURL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="group block p-6 rounded-2xl bg-slate-900/80 border border-slate-800/90 hover:border-slate-700 backdrop-blur-xl shadow-xl transition-all duration-200 hover:-translate-y-0.5">
					<div class="flex items-start justify-between gap-4 mb-3">
						<div class="flex items-center gap-3">
							<div class="w-3 h-3 rounded-full flex-shrink-0" style={ fmt.Sprintf("background-color: %s;", p.Color) }></div>
							<h3 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors truncate">{ p.Name }</h3>
						</div>
						<span class={ "px-2.5 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider " + statusBadgeClass(p.Status) }>
							{ p.Status }
						</span>
					</div>

					if p.Description != "" {
						<p class="text-slate-400 text-xs line-clamp-2 mb-4 leading-relaxed">{ p.Description }</p>
					}

					<!-- Tech Stack Badges -->
					if p.TechStack != "" {
						<div class="flex flex-wrap gap-1.5 mb-4">
							for _, tag := range strings.Split(p.TechStack, ",") {
								if strings.TrimSpace(tag) != "" {
									<span class="px-2 py-0.5 rounded-md bg-indigo-950/60 border border-indigo-800/50 text-[10px] font-semibold text-indigo-300">
										{ strings.TrimSpace(tag) }
									</span>
								}
							}
						</div>
					}

					<!-- GitHub Stats Snippet -->
					if p.GithubUrl != "" {
						<div class="flex items-center gap-3 text-xs text-slate-400 py-2 border-t border-b border-slate-800/60 mb-4">
							<div class="flex items-center gap-1">
								<i data-lucide="star" class="w-3.5 h-3.5 text-amber-400"></i>
								<span>{ fmt.Sprintf("%d", p.GithubStars) }</span>
							</div>
							<div class="flex items-center gap-1">
								<i data-lucide="git-fork" class="w-3.5 h-3.5 text-indigo-400"></i>
								<span>{ fmt.Sprintf("%d", p.GithubForks) }</span>
							</div>
							if p.GithubLanguage != "" {
								<div class="ml-auto text-[11px] font-semibold text-slate-300">
									{ p.GithubLanguage }
								</div>
							}
						</div>
					}

					<!-- Progress Bar -->
					<div class="space-y-1.5">
						<div class="flex justify-between text-xs font-semibold">
							<span class="text-slate-400">Progress</span>
							<span class="text-indigo-400">{ fmt.Sprintf("%d%%", p.ProgressPercentage) }</span>
						</div>
						<div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
							<div class="h-full bg-indigo-500 transition-all duration-300" style={ fmt.Sprintf("width: %d%%;", p.ProgressPercentage) }></div>
						</div>
					</div>
				</a>
			}
		</div>
	}
}

func filterTabClass(active bool) string {
	base := "px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 transition-all "
	if active {
		return base + "bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 shadow-sm"
	}
	return base + "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60"
}

func statusBadgeClass(status string) string {
	switch strings.ToLower(status) {
	case "active":
		return "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
	case "completed":
		return "bg-indigo-500/10 text-indigo-400 border border-indigo-500/20"
	case "archived":
		return "bg-slate-800 text-slate-400 border border-slate-700"
	default:
		return "bg-amber-500/10 text-amber-400 border border-amber-500/20"
	}
}
