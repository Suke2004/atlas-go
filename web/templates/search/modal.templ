package search

import (
	"fmt"
)

templ Results(results []SearchResultItem, query string) {
	if len(results) == 0 {
		<div class="p-8 text-center space-y-2">
			<div class="w-10 h-10 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
				<i data-lucide="search-x" class="w-5 h-5"></i>
			</div>
			<p class="text-xs text-slate-400">No results found for "<span class="text-white font-semibold">{ query }</span>"</p>
		</div>
	} else {
		<div class="p-2 space-y-1">
			for _, item := range results {
				<a href={ templ.URL(item.URL) } hx-boost="true" class="p-3 rounded-2xl bg-slate-900/80 hover:bg-slate-800/90 border border-slate-800/80 hover:border-slate-700 flex items-center justify-between gap-3 transition-all group">
					<div class="flex items-center gap-3">
						<div class="w-8 h-8 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center">
							<i data-lucide={ item.Icon } class="w-4 h-4"></i>
						</div>
						<div>
							<h4 class="text-xs font-bold text-white group-hover:text-indigo-400 transition-colors leading-snug">{ item.Title }</h4>
							if item.Subtitle != "" {
								<p class="text-[11px] text-slate-400 line-clamp-1">{ item.Subtitle }</p>
							}
						</div>
					</div>
					<span class="px-2 py-0.5 rounded-full bg-slate-800 text-[10px] font-mono-code font-bold uppercase text-slate-300 border border-slate-700">{ item.Badge }</span>
				</a>
			}
		</div>
	}
}
