package notes

import (
	"fmt"
	"strings"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ List(notesList []NoteWithDetails, summary NotesSummary, availableProjects []db.Project, currentTag string, viewMode string, searchQuery string, errorMsg string) {
	<div class="space-y-8" x-data="{ showQuickCapture: false }">
		<!-- Knowledge Base Hero Banner -->
		<div class="p-6 md:p-8 rounded-3xl glass-panel relative overflow-hidden">
			<div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div>
					<div class="flex items-center gap-3 mb-2">
						<span class="px-3 py-1 rounded-full badge-tech text-xs uppercase tracking-widest flex items-center gap-1.5 font-mono-code">
							<i data-lucide="book-open" class="w-3.5 h-3.5 text-cyan-400"></i>
							Knowledge & Wiki
						</span>
						<span class="text-xs text-slate-500 font-mono-code hidden sm:inline-block">Wiki Links [[Title]] Enabled</span>
					</div>
					<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Knowledge Base</h1>
					<p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
						Your personal wiki, technical decisions, meeting notes, and interconnected thoughts.
					</p>
				</div>

				<div class="flex items-center gap-3">
					<a href="/notes/new" hx-boost="true" class="px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-xl shadow-indigo-500/20 flex items-center gap-2.5 transition-all duration-200 hover:-translate-y-0.5">
						<i data-lucide="plus" class="w-4 h-4"></i>
						<span>New Note</span>
					</a>
				</div>
			</div>

			<!-- Quick Template Pills Bar -->
			<div class="mt-8 pt-6 border-t border-slate-800/80 space-y-3">
				<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
					<i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
					<span>Quick Start Templates</span>
				</div>
				<div class="flex items-center gap-3 overflow-x-auto pb-1">
					<a href="/notes/new?template=adr" hx-boost="true" class="px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-2 transition-all">
						<i data-lucide="file-code-2" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>ADR Record</span>
					</a>
					<a href="/notes/new?template=meeting" hx-boost="true" class="px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-2 transition-all">
						<i data-lucide="users" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Meeting Notes</span>
					</a>
					<a href="/notes/new?template=brainstorm" hx-boost="true" class="px-3.5 py-2 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-2 transition-all">
						<i data-lucide="lightbulb" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Feature Brainstorm</span>
					</a>
				</div>
			</div>

			<!-- Metrics Row -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-6 border-t border-slate-800/80">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="file-text" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Total Notes</span>
					</div>
					<div class="text-2xl font-extrabold text-white font-mono-code">{ fmt.Sprintf("%d", summary.TotalNotes) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="pin" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Pinned Notes</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-400 font-mono-code">{ fmt.Sprintf("%d", summary.PinnedNotes) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="tag" class="w-3.5 h-3.5 text-cyan-400"></i>
						<span>Indexed Tags</span>
					</div>
					<div class="text-2xl font-extrabold text-cyan-400 font-mono-code">{ fmt.Sprintf("%d", summary.TotalTags) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="link" class="w-3.5 h-3.5 text-emerald-400"></i>
						<span>Network Wiki</span>
					</div>
					<div class="text-2xl font-extrabold text-emerald-400 font-mono-code">Active</div>
				</div>
			</div>
		</div>

		<!-- Control Toolbar: Tag Filter Tabs & Live Search -->
		<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 glass-panel p-4 rounded-2xl">
			<!-- Tag Filter Tabs -->
			<div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0">
				<a href="/notes?tag=all" hx-boost="true" class={ filterTabClass(currentTag == "all" || currentTag == "") }>
					<span>All Notes</span>
					<span class="px-2 py-0.5 rounded-full bg-slate-800 text-[11px] text-slate-300 font-mono-code">{ fmt.Sprintf("%d", summary.TotalNotes) }</span>
				</a>
				for _, tag := range summary.AllTags {
					<a href={ templ.URL(fmt.Sprintf("/notes?tag=%s", tag)) } hx-boost="true" class={ filterTabClass(currentTag == tag) }>
						<span>#{ tag }</span>
					</a>
				}
			</div>

			<!-- Search Input -->
			<div class="flex items-center gap-3">
				<form action="/notes" method="GET" hx-boost="true" class="relative min-w-[240px]">
					<i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
					<input type="text" name="search" value={ searchQuery } placeholder="Search notes..." class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
				</form>
			</div>
		</div>

		<!-- Notes Grid Container -->
		<div id="notes-content">
			if len(notesList) == 0 {
				<div class="text-center py-20 px-4 glass-panel rounded-3xl space-y-4">
					<div class="w-14 h-14 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto text-2xl font-bold border border-slate-700">
						<i data-lucide="book-open" class="w-7 h-7"></i>
					</div>
					<h3 class="text-xl font-bold text-white">No notes found</h3>
					<p class="text-slate-400 text-sm max-w-md mx-auto leading-relaxed">
						Create your first note or select a quick start template to get started.
					</p>
					<a href="/notes/new" hx-boost="true" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-xs font-bold shadow-md">Create Note</a>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, n := range notesList {
						<a href={ templ.URL(fmt.Sprintf("/notes/%d", n.Note.ID)) } hx-boost="true" class="p-6 rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all space-y-4 group flex flex-col justify-between shadow-lg">
							<div class="space-y-3">
								<div class="flex items-start justify-between gap-3">
									<h3 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors leading-snug">{ n.Note.Title }</h3>
									if n.Note.IsPinned {
										<span class="text-amber-400 p-1" title="Pinned Note">
											<i data-lucide="pin" class="w-4 h-4 fill-amber-400"></i>
										</span>
									}
								</div>

								if n.Note.Content != "" {
									<p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">{ truncateContent(n.Note.Content, 140) }</p>
								}
							</div>

							<div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono-code">
								<div class="flex items-center gap-2">
									if n.ProjectName != "" {
										<span class="flex items-center gap-1 text-indigo-400">
											<i data-lucide="folder" class="w-3 h-3"></i>
											<span>{ n.ProjectName }</span>
										</span>
									}
									<span class="flex items-center gap-1 text-slate-400">
										<i data-lucide="clock" class="w-3 h-3"></i>
										<span>{ fmt.Sprintf("%dm read", n.ReadingTime) }</span>
									</span>
								</div>

								<form action={ templ.URL(fmt.Sprintf("/notes/%d/delete", n.Note.ID)) } method="POST" onsubmit="return confirm('Delete this note?');">
									<button type="submit" class="text-slate-500 hover:text-rose-400 transition-colors p-1">
										<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
									</button>
								</form>
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

func truncateContent(s string, limit int) string {
	clean := strings.ReplaceAll(s, "#", "")
	clean = strings.ReplaceAll(clean, "*", "")
	clean = strings.TrimSpace(clean)
	if len(clean) > limit {
		return clean[:limit] + "..."
	}
	return clean
}

func filterTabClass(active bool) string {
	base := "px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2 transition-all "
	if active {
		return base + "bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 shadow-sm"
	}
	return base + "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60"
}
