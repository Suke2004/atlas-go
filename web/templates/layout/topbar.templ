package layout

templ Topbar(pageTitle string, username string) {
	<header class="h-16 px-8 border-b border-slate-800/80 bg-slate-900/80 backdrop-blur-xl flex items-center justify-between flex-shrink-0 z-10">
		<!-- Page Title / Breadcrumb -->
		<div class="flex items-center gap-3">
			<h1 class="text-xl font-bold text-white tracking-tight">{ pageTitle }</h1>
		</div>

		<!-- Right Controls: Global Search + Theme Toggle + User -->
		<div class="flex items-center gap-4">
			<!-- Global Search Trigger Button (Ctrl+K) -->
			<button id="global-search-trigger" type="button" class="flex items-center gap-3 px-4 py-2 rounded-xl bg-slate-800/60 border border-slate-700/70 text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-all text-xs font-medium group">
				<i data-lucide="search" class="w-4 h-4 text-slate-500 group-hover:text-indigo-400 transition-colors"></i>
				<span>Search Atlas...</span>
				<kbd class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-[10px] text-slate-400 font-mono">Ctrl K</kbd>
			</button>

			<!-- Theme Switcher Toggle -->
			<div class="relative" x-data="{ open: false }">
				<button @click="open = !open" type="button" title="Switch Theme" class="p-2 rounded-xl bg-slate-800/60 border border-slate-700/70 text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-all">
					<i data-lucide="sun" class="w-4 h-4 hidden [html[data-theme='light']_&]:block text-amber-400"></i>
					<i data-lucide="moon" class="w-4 h-4 hidden [html[data-theme='dark']_&]:block text-indigo-400"></i>
					<i data-lucide="monitor" class="w-4 h-4 hidden [html[data-theme='system']_&]:block text-slate-400"></i>
				</button>

				<!-- Theme Dropdown Menu -->
				<div x-show="open" @click.outside="open = false" x-transition class="absolute right-0 mt-2 w-36 rounded-xl bg-slate-900 border border-slate-800 shadow-xl py-1 z-50 text-xs font-medium">
					<button onclick="setAtlasTheme('light')" @click="open = false" class="w-full px-3 py-2 text-left text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2">
						<i data-lucide="sun" class="w-3.5 h-3.5 text-amber-400"></i> Light
					</button>
					<button onclick="setAtlasTheme('dark')" @click="open = false" class="w-full px-3 py-2 text-left text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2">
						<i data-lucide="moon" class="w-3.5 h-3.5 text-indigo-400"></i> Dark
					</button>
					<button onclick="setAtlasTheme('system')" @click="open = false" class="w-full px-3 py-2 text-left text-slate-300 hover:text-white hover:bg-slate-800 flex items-center gap-2">
						<i data-lucide="monitor" class="w-3.5 h-3.5 text-slate-400"></i> System
					</button>
				</div>
			</div>
		</div>
	</header>
}
