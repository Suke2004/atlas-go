package layout

templ Base(title string, currentPath string, username string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark" class="h-full bg-slate-950 text-slate-100">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Atlas</title>
			<!-- Custom Design System CSS -->
			<link rel="stylesheet" href="/static/css/app.css"/>
			<!-- Tailwind CSS Browser Engine -->
			<script src="https://cdn.tailwindcss.com"></script>
			<!-- Local Vendor JS Libraries -->
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/alpine.min.js" defer></script>
			<script src="/static/js/lucide.min.js"></script>
			<script src="https://unpkg.com/lucide@latest"></script>
			<script>
				function setAtlasTheme(theme) {
					document.documentElement.setAttribute('data-theme', theme);
					localStorage.setItem('atlas_theme', theme);
				}
				(function() {
					const saved = localStorage.getItem('atlas_theme') || 'dark';
					document.documentElement.setAttribute('data-theme', saved);
				})();
			</script>
		</head>
		<body class="h-full flex overflow-hidden bg-slate-950 text-slate-100">
			<!-- Sidebar Component -->
			@Sidebar(currentPath, username)

			<!-- Main Container -->
			<div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden">
				<!-- Topbar Component -->
				@Topbar(title, username)

				<!-- Main Content Target (HTMX Swap Container) -->
				<main id="main-content" class="flex-1 overflow-y-auto p-8 relative">
					@content
				</main>
			</div>

			<!-- Global Toast Container -->
			<div id="toast-container" class="fixed bottom-6 right-6 space-y-3 z-50 pointer-events-none [&>*]:pointer-events-auto"></div>

			<!-- Global Ctrl+K Command Palette Modal Overlay -->
			<div x-data="{ open: false }"
				@keydown.window.cmd.k.prevent="open = true"
				@keydown.window.ctrl.k.prevent="open = true"
				@keydown.escape.window="open = false"
				x-show="open"
				x-cloak
				class="fixed inset-0 z-50 flex items-start justify-center pt-20 px-4 bg-slate-950/80 backdrop-blur-md">
				
				<div @click.away="open = false" class="w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden space-y-3">
					<div class="p-4 border-b border-slate-800 flex items-center gap-3">
						<i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
						<input type="text"
							placeholder="Type to search projects, tasks, notes... (Esc to close)"
							hx-get="/api/search"
							hx-trigger="keyup changed delay:200ms"
							hx-target="#cmd-palette-results"
							class="w-full bg-transparent text-white font-semibold text-sm focus:outline-none placeholder-slate-500"
							autofocus/>
						<span class="px-2 py-1 rounded-lg bg-slate-800 text-[10px] font-mono-code text-slate-400">Esc</span>
					</div>

					<div id="cmd-palette-results" class="max-h-96 overflow-y-auto p-2">
						<div class="p-6 text-center text-xs text-slate-500 font-mono-code">
							Start typing to search workspace...
						</div>
					</div>
				</div>
			</div>

			<script>
				document.addEventListener('DOMContentLoaded', function() {
					if (typeof lucide !== 'undefined' && lucide.createIcons) {
						lucide.createIcons();
					}
				});
				document.body.addEventListener('htmx:afterSwap', function() {
					if (typeof lucide !== 'undefined' && lucide.createIcons) {
						lucide.createIcons();
					}
				});
			</script>
		</body>
	</html>
}
