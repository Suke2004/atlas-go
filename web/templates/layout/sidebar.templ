package layout

type NavItem struct {
	Title string
	Path  string
	Icon  string
	Active bool
}

templ Sidebar(currentPath string, username string) {
	<aside id="sidebar" class="w-64 flex-shrink-0 h-full bg-slate-900/95 border-r border-slate-800/80 flex flex-col transition-all duration-300 select-none">
		<!-- Brand / Logo Header -->
		<div class="h-16 px-6 flex items-center justify-between border-b border-slate-800/60">
			<a href="/" class="flex items-center gap-3 group">
				<div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 text-white font-bold flex items-center justify-center shadow-md shadow-indigo-600/30 group-hover:scale-105 transition-transform">
					A
				</div>
				<div class="flex flex-col">
					<span class="text-lg font-bold text-white tracking-tight leading-none">Atlas</span>
					<span class="text-[10px] font-semibold text-indigo-400 uppercase tracking-widest leading-tight mt-0.5">Personal OS</span>
				</div>
			</a>
		</div>

		<!-- Navigation Links -->
		<nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
			<div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">Workspace</div>

			<a href="/" hx-boost="true" class={ navClass(currentPath == "/") }>
				<i data-lucide="layout-dashboard" class="w-4 h-4"></i>
				<span>Dashboard</span>
			</a>

			<a href="/projects" hx-boost="true" class={ navClass(currentPath == "/projects") }>
				<i data-lucide="folder-kanban" class="w-4 h-4"></i>
				<span>Projects</span>
			</a>

			<a href="/tasks" hx-boost="true" class={ navClass(currentPath == "/tasks") }>
				<i data-lucide="check-square" class="w-4 h-4"></i>
				<span>Tasks</span>
			</a>

			<a href="/notes" hx-boost="true" class={ navClass(currentPath == "/notes") }>
				<i data-lucide="book-open" class="w-4 h-4"></i>
				<span>Knowledge Base</span>
			</a>

			<a href="/journal" hx-boost="true" class={ navClass(currentPath == "/journal") }>
				<i data-lucide="feather" class="w-4 h-4"></i>
				<span>Daily Journal</span>
			</a>

			<div class="pt-4">
				<div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">Intelligence</div>
				<a href="/analytics" hx-boost="true" class={ navClass(currentPath == "/analytics") }>
					<i data-lucide="line-chart" class="w-4 h-4"></i>
					<span>Analytics</span>
				</a>
				<a href="/documents" hx-boost="true" class={ navClass(currentPath == "/documents") }>
					<i data-lucide="library" class="w-4 h-4"></i>
					<span>Documents</span>
				</a>
				<a href="/finance" hx-boost="true" class={ navClass(currentPath == "/finance") }>
					<i data-lucide="wallet" class="w-4 h-4"></i>
					<span>Finance</span>
				</a>
				<a href="/learning" hx-boost="true" class={ navClass(currentPath == "/learning") }>
					<i data-lucide="graduation-cap" class="w-4 h-4"></i>
					<span>Learning</span>
				</a>
			</div>
			<div class="pt-4">
				<div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-2">System</div>
				<a href="/settings" hx-boost="true" class={ navClass(currentPath == "/settings") }>
					<i data-lucide="settings" class="w-4 h-4"></i>
					<span>Settings</span>
				</a>
			</div>
		</nav>

		<!-- User Footer -->
		<div class="p-4 border-t border-slate-800/60 flex items-center justify-between bg-slate-950/40">
			<div class="flex items-center gap-3 min-w-0">
				<div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 text-indigo-400 font-semibold flex items-center justify-center text-sm flex-shrink-0">
					if len(username) > 0 {
						{ string(username[0]) }
					} else {
						A
					}
				</div>
				<div class="flex flex-col min-w-0">
					<span class="text-xs font-medium text-slate-200 truncate">{ username }</span>
					<span class="text-[10px] text-slate-500 truncate">Owner Account</span>
				</div>
			</div>
			<form action="/logout" method="POST">
				<button type="submit" title="Log Out" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition-colors">
					<i data-lucide="log-out" class="w-4 h-4"></i>
				</button>
			</form>
		</div>
	</aside>
}

func navClass(isActive bool) string {
	base := "flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-150 "
	if isActive {
		return base + "bg-indigo-600/15 text-indigo-400 border border-indigo-500/30 shadow-sm"
	}
	return base + "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60"
}
