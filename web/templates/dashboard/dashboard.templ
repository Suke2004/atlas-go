package dashboard

import (
	"fmt"
	"github.com/Suke2004/atlas-go/internal/db"
	projecttemplates "github.com/Suke2004/atlas-go/web/templates/projects"
	tasktemplates "github.com/Suke2004/atlas-go/web/templates/tasks"
)

templ Dashboard(displayName string, projSummary projecttemplates.ProjectsSummary, activeProjects []db.Project, taskSummary tasktemplates.TasksSummary, focusTasks []tasktemplates.TaskWithDetails) {
	<div class="space-y-8">
		<!-- Welcome Hero Banner -->
		<div class="p-6 md:p-8 rounded-3xl glass-panel relative overflow-hidden">
			<div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div>
					<div class="flex items-center gap-3 mb-2">
						<span class="px-3 py-1 rounded-full badge-tech text-xs uppercase tracking-widest flex items-center gap-1.5 font-mono-code">
							<i data-lucide="cpu" class="w-3.5 h-3.5 text-indigo-400"></i>
							System Core
						</span>
						<span class="text-xs text-slate-500 font-mono-code">Self-Hosted Workspace</span>
					</div>
					<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Welcome back, { displayName }</h1>
					<p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
						Your personal command center. Track active projects, tackle high-priority deliverables, and manage your daily workflow.
					</p>
				</div>

				<div class="flex items-center gap-3">
					<a href="/tasks" hx-boost="true" class="px-5 py-2.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-xl shadow-indigo-500/20 flex items-center gap-2 transition-all">
						<i data-lucide="check-square" class="w-4 h-4"></i>
						<span>Open Tasks</span>
					</a>
					<a href="/projects" hx-boost="true" class="px-5 py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm transition-all border border-slate-700">
						<i data-lucide="folder" class="w-4 h-4"></i>
						<span>Projects</span>
					</a>
				</div>
			</div>

			<!-- Executive Metrics Row -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-slate-800/80">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="folder-git-2" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Active Initiatives</span>
					</div>
					<div class="text-2xl font-extrabold text-white font-mono-code">{ fmt.Sprintf("%d", projSummary.ActiveProjects) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Today's Focus</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-400 font-mono-code">{ fmt.Sprintf("%d", taskSummary.TodayFocusTasks) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="star" class="w-3.5 h-3.5 text-amber-300"></i>
						<span>GitHub Stars</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-300 font-mono-code">{ fmt.Sprintf("%d", projSummary.TotalStars) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i>
						<span>Task Completion</span>
					</div>
					<div class="text-2xl font-extrabold text-emerald-400 font-mono-code">{ fmt.Sprintf("%d%%", taskSummary.CompletionRate) }</div>
				</div>
			</div>
		</div>

		<!-- Main 2-Column Dashboard Grid -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			<!-- Left 2-Cols: Active Initiatives -->
			<div class="lg:col-span-2 space-y-6">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
						<i data-lucide="folder" class="w-5 h-5 text-indigo-400"></i>
						<span>Active Initiatives</span>
					</h2>
					<a href="/projects" hx-boost="true" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1">
						<span>View all ({ fmt.Sprintf("%d", projSummary.TotalProjects) })</span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
					</a>
				</div>

				if len(activeProjects) == 0 {
					<div class="p-8 rounded-3xl glass-panel text-center space-y-3">
						<div class="w-12 h-12 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
							<i data-lucide="folder-plus" class="w-6 h-6"></i>
						</div>
						<h3 class="text-base font-bold text-white">No active projects</h3>
						<p class="text-xs text-slate-400 max-w-sm mx-auto">Start by creating your first project initiative.</p>
						<a href="/projects" hx-boost="true" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold shadow-md">Create Project</a>
					</div>
				} else {
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						for _, p := range activeProjects {
							<a href={ templ.URL(fmt.Sprintf("/projects/%d", p.ID)) } hx-boost="true" class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-slate-700 transition-all space-y-3 group">
								<div class="flex items-start justify-between gap-3">
									<h3 class="text-base font-bold text-white group-hover:text-indigo-400 transition-colors leading-snug">{ p.Name }</h3>
									<span class="px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 text-[10px] font-mono-code font-bold uppercase">{ p.Status }</span>
								</div>

								if p.Description != "" {
									<p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">{ p.Description }</p>
								}

								if p.TechStack != "" {
									<div class="text-[11px] font-mono-code text-slate-400 flex items-center gap-1">
										<i data-lucide="code-2" class="w-3 h-3 text-cyan-400"></i>
										<span>{ p.TechStack }</span>
									</div>
								}
							</a>
						}
					</div>
				}
			</div>

			<!-- Right Col: Today's Focus Queue -->
			<div class="space-y-6">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
						<i data-lucide="zap" class="w-5 h-5 text-amber-400"></i>
						<span>Today's Focus</span>
					</h2>
					<a href="/tasks" hx-boost="true" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1">
						<span>Task Board</span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
					</a>
				</div>

				if len(focusTasks) == 0 {
					<div class="p-8 rounded-3xl glass-panel text-center space-y-3">
						<div class="w-12 h-12 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
							<i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-400"></i>
						</div>
						<h3 class="text-base font-bold text-white">All caught up!</h3>
						<p class="text-xs text-slate-400">No urgent focus tasks pending today.</p>
					</div>
				} else {
					<div class="space-y-3">
						for _, t := range focusTasks {
							<div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2 hover:border-slate-700 transition-all">
								<div class="flex items-start justify-between gap-3">
									<h4 class="text-xs font-bold text-white leading-snug">{ t.Task.Title }</h4>
									<span class="px-2 py-0.5 rounded-md text-[10px] font-mono-code uppercase font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">{ t.Task.Priority }</span>
								</div>

								if t.ProjectName != "" {
									<div class="text-[11px] font-mono-code text-indigo-400 flex items-center gap-1">
										<i data-lucide="folder" class="w-3 h-3"></i>
										<span>{ t.ProjectName }</span>
									</div>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
}
