package finance

import (
	"fmt"
	"github.com/Suke2004/atlas-go/internal/db"
)

templ Finance(txns []db.Transaction, summary FinanceSummary) {
	<div class="space-y-8" x-data="{ showNewTxn: false }">
		<!-- Finance Hero Banner -->
		<div class="p-6 md:p-8 rounded-3xl glass-panel relative overflow-hidden">
			<div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
				<div>
					<div class="flex items-center gap-3 mb-2">
						<span class="px-3 py-1 rounded-full badge-tech text-xs uppercase tracking-widest flex items-center gap-1.5 font-mono-code">
							<i data-lucide="wallet" class="w-3.5 h-3.5 text-emerald-400"></i>
							Financial Control
						</span>
						<span class="text-xs text-slate-500 font-mono-code">Project Cost Attribution Enabled</span>
					</div>
					<h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Finance & Budget Engine</h1>
					<p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
						Track monthly cash flow, zero-based budget allocation, and infrastructure expense attribution per project.
					</p>
				</div>

				<div class="flex items-center gap-3">
					<button @click="showNewTxn = !showNewTxn" type="button" class="px-6 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-500/20 flex items-center gap-2.5 transition-all">
						<i data-lucide="plus" class="w-4 h-4"></i>
						<span>Add Transaction</span>
					</button>
				</div>
			</div>

			<!-- Cash Flow Telemetry Cards -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-slate-800/80">
				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="trending-up" class="w-3.5 h-3.5 text-emerald-400"></i>
						<span>Total Income</span>
					</div>
					<div class="text-2xl font-extrabold text-emerald-400 font-mono-code">${ fmt.Sprintf("%.2f", summary.TotalIncome) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="trending-down" class="w-3.5 h-3.5 text-rose-400"></i>
						<span>Total Expenses</span>
					</div>
					<div class="text-2xl font-extrabold text-rose-400 font-mono-code">${ fmt.Sprintf("%.2f", summary.TotalExpenses) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="piggy-bank" class="w-3.5 h-3.5 text-indigo-400"></i>
						<span>Net Savings</span>
					</div>
					<div class="text-2xl font-extrabold text-white font-mono-code">${ fmt.Sprintf("%.2f", summary.NetSavings) }</div>
				</div>

				<div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80">
					<div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1 flex items-center gap-1.5">
						<i data-lucide="pie-chart" class="w-3.5 h-3.5 text-amber-400"></i>
						<span>Savings Rate</span>
					</div>
					<div class="text-2xl font-extrabold text-amber-400 font-mono-code">{ fmt.Sprintf("%d%%", summary.SavingsRate) }</div>
				</div>
			</div>
		</div>

		<!-- New Transaction Form Drawer Modal -->
		<div x-show="showNewTxn" x-cloak class="glass-panel p-6 rounded-3xl space-y-4">
			<h3 class="text-base font-bold text-white flex items-center gap-2">
				<i data-lucide="plus-circle" class="w-5 h-5 text-emerald-400"></i>
				<span>Log New Transaction</span>
			</h3>
			<form action="/finance" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Type</label>
					<select name="type" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs">
						<option value="expense">Expense</option>
						<option value="income">Income</option>
					</select>
				</div>
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Amount ($)</label>
					<input type="number" step="0.01" name="amount" required placeholder="99.00" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono-code"/>
				</div>
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Category</label>
					<input type="text" name="category" required placeholder="Hosting, Domain, SaaS" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs"/>
				</div>
				<div>
					<label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Description</label>
					<input type="text" name="description" placeholder="Vercel, Hetzner, OpenAI" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs"/>
				</div>
				<div class="flex items-end">
					<button type="submit" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md">Save Transaction</button>
				</div>
			</form>
		</div>

		<!-- Project Cost Attribution USP Grid -->
		if len(summary.ProjectCosts) > 0 {
			<div class="space-y-4">
				<h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
					<i data-lucide="layers" class="w-5 h-5 text-indigo-400"></i>
					<span>Project Infrastructure Cost Attribution (USP)</span>
				</h2>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, cost := range summary.ProjectCosts {
						<div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
							<div class="flex items-center justify-between">
								<h3 class="text-sm font-bold text-white leading-snug">{ cost.ProjectName }</h3>
								<span class="px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 text-[10px] font-mono-code font-bold">{ fmt.Sprintf("%d%% budget", cost.Percentage) }</span>
							</div>
							<div class="text-lg font-extrabold text-cyan-400 font-mono-code">${ fmt.Sprintf("%.2f / mo", cost.MonthlyCost) }</div>
						</div>
					}
				</div>
			</div>
		}

		<!-- Transaction Ledger Table -->
		<div class="glass-panel p-6 rounded-3xl space-y-4">
			<h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
				<i data-lucide="list" class="w-5 h-5 text-emerald-400"></i>
				<span>Transaction Ledger</span>
			</h2>

			if len(txns) == 0 {
				<div class="text-center py-12 text-slate-500 text-xs">No financial transactions logged yet.</div>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs text-slate-300">
						<thead class="bg-slate-900/80 text-slate-400 font-mono-code text-[11px] uppercase border-b border-slate-800">
							<tr>
								<th class="p-3.5">Date</th>
								<th class="p-3.5">Category</th>
								<th class="p-3.5">Description</th>
								<th class="p-3.5">Type</th>
								<th class="p-3.5 text-right">Amount</th>
								<th class="p-3.5 text-right">Actions</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/80">
							for _, t := range txns {
								<tr class="hover:bg-slate-900/50 transition-colors">
									<td class="p-3.5 font-mono-code text-slate-400">{ t.TransactionDate }</td>
									<td class="p-3.5 font-semibold text-white">{ t.Category }</td>
									<td class="p-3.5 text-slate-400">{ t.Description }</td>
									<td class="p-3.5">
										if t.Type == "income" {
											<span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 font-mono-code text-[10px] uppercase font-bold">Income</span>
										} else {
											<span class="px-2 py-0.5 rounded-md bg-rose-500/10 text-rose-400 font-mono-code text-[10px] uppercase font-bold">Expense</span>
										}
									</td>
									<td class="p-3.5 text-right font-mono-code font-bold text-white">${ fmt.Sprintf("%.2f", t.Amount) }</td>
									<td class="p-3.5 text-right">
										<form action={ templ.URL(fmt.Sprintf("/finance/%d/delete", t.ID)) } method="POST">
											<button type="submit" class="text-slate-500 hover:text-rose-400 p-1">
												<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
