# deploy/Caddyfile — Production reverse proxy configuration
# Replace "your-domain.com" with your actual domain.
# Caddy handles TLS automatically via Let's Encrypt.

your-domain.com {
    # Reverse proxy all requests to the Atlas Go server
    reverse_proxy localhost:8080

    # Enable gzip compression for HTML, CSS, JS
    encode gzip

    # Security headers
    header {
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Enable XSS protection in older browsers
        X-XSS-Protection "1; mode=block"
        # Only send referrer for same-origin requests
        Referrer-Policy "same-origin"
        # Remove server header (do not leak Caddy version)
        -Server
    }

    # Log access in JSON format
    log {
        output file /var/log/caddy/atlas-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# Redirect www → apex
www.your-domain.com {
    redir https://your-domain.com{uri} permanent
}